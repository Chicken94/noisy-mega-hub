modules = ["nodejs-20", "web"]
run = "npm install && npm run dev"
entrypoint = "app/page.tsx"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm run start"]

[[ports]]
localPort = 3000
externalPort = 80
